@model IEnumerable<BloodBankNetwork.Models.BloodRequest>

<div class="container-fluid py-4">
    
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <strong>⚠️ Stock Alert:</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <strong>✅ Success:</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <h2 class="text-secondary fw-bold mb-0">📋 Blood Requests Queue</h2>
        
        <div class="d-flex flex-column flex-sm-row gap-2 align-items-sm-center w-100 w-md-auto">
            <form method="get" class="d-flex flex-grow-1 gap-2">
                <input type="text" 
                       name="search" 
                       class="form-control shadow-sm flex-grow-1" 
                       placeholder="Search hospital or blood group..." 
                       value="@Context.Request.Query["search"]" />
                <button type="submit" class="btn btn-primary shadow-sm text-nowrap">Search</button>
                <a asp-action="Index" class="btn btn-outline-secondary shadow-sm text-nowrap">Reset</a>
            </form>

            <a asp-action="Create" class="btn btn-success shadow-sm text-nowrap w-100 w-sm-auto text-center">
                ➕ Create New Request
            </a>
        </div>
    </div>

    @{
        int rowCount = 1;
    }

    <!-- Desktop View: Visible on md screens and larger -->
    <div class="card shadow-sm border-0 d-none d-md-block">
        <div class="table-responsive p-3">
            <table class="table align-middle table-hover mb-0">
                <thead class="table-light text-secondary small">
                    <tr>
                        <th>Sr. No</th>
                        <th>Hospital Name</th>
                        <th class="text-center">Blood Group</th>
                        <th class="text-center">Units Needed</th>
                        <th>Request Date</th>
                        <th class="text-center">Urgency</th>
                        <th class="text-center">Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold text-dark">@(rowCount++)</td>
                            <td class="fw-semibold">@item.HospitalName</td>
                            <td class="text-center">
                                <span class="badge bg-primary px-2.5 py-1.5">@item.BloodGroup</span>
                            </td>
                            <td class="text-center fw-bold text-dark">@item.UnitsNeeded</td>
                            <td class="text-muted small">@item.RequestDate.ToString("MM/dd/yyyy hh:mm tt")</td>
                            <td class="text-center">
                                @if (item.Urgency == "High")
                                {
                                    <span class="badge bg-danger px-2.5 py-1.5 fw-bold">Emergency</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-2.5 py-1.5">Normal</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (item.Status == "Approved")
                                {
                                    <span class="badge bg-light text-success border border-success px-2 py-1 fw-bold">✓ Approved</span>
                                }
                                else if (item.Status == "Rejected")
                                {
                                    <span class="badge bg-light text-danger border border-danger px-2 py-1 fw-bold">✕ Rejected</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-warning border border-warning px-2 py-1 fw-bold">● Pending</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1 align-items-center">
                                    @if (item.Status == "Pending")
                                    {
                                        <a asp-action="Approve" asp-route-id="@item.RequestID" class="btn btn-sm btn-success fw-bold px-2.5">
                                            ✓ Approve
                                        </a>
                                        <a asp-action="Reject" asp-route-id="@item.RequestID" class="btn btn-sm btn-outline-secondary px-2.5">
                                            ✕ Reject
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small fst-italic me-2">Processed</span>
                                    }

                                    <a asp-action="Delete" 
                                       asp-route-id="@item.RequestID" 
                                       class="btn btn-sm btn-outline-danger ms-2" 
                                       onclick="return confirm('Delete this request permanently?')">
                                         Delete
                                     </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Mobile View: Visible on screens smaller than md -->
    <div class="d-md-none">
        @{
            int mobileRowCount = 1;
        }
        @foreach (var item in Model)
        {
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <div class="text-muted small mb-1">Request #@(mobileRowCount++)</div>
                            <h5 class="fw-bold text-dark mb-0">@item.HospitalName</h5>
                        </div>
                        <span class="badge bg-primary px-3 py-2 fs-6">@item.BloodGroup</span>
                    </div>

                    <hr class="my-2 text-muted opacity-25">

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <span class="text-muted small d-block">Units Needed</span>
                            <span class="fw-bold text-dark fs-5">@item.UnitsNeeded</span>
                        </div>
                        <div class="col-6 text-end">
                            <span class="text-muted small d-block">Urgency</span>
                            @if (item.Urgency == "High")
                            {
                                <span class="badge bg-danger px-2.5 py-1.5 fw-bold">Emergency</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary px-2.5 py-1.5">Normal</span>
                            }
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <span class="text-muted small d-block">Request Date</span>
                            <span class="text-dark small fw-medium">@item.RequestDate.ToString("MM/dd/yyyy hh:mm tt")</span>
                        </div>
                        <div>
                            <span class="text-muted small d-block text-end mb-1">Status</span>
                            @if (item.Status == "Approved")
                            {
                                <span class="badge bg-light text-success border border-success px-2 py-1 fw-bold">✓ Approved</span>
                              }
                            else if (item.Status == "Rejected")
                            {
                                <span class="badge bg-light text-danger border border-danger px-2 py-1 fw-bold">✕ Rejected</span>
                            }
                            else
                            {
                                <span class="badge bg-light text-warning border border-warning px-2 py-1 fw-bold">● Pending</span>
                            }
                        </div>
                    </div>

                    <div class="border-top pt-2 mt-2">
                        <div class="d-flex justify-content-end gap-2 align-items-center">
                            @if (item.Status == "Pending")
                            {
                                <a asp-action="Approve" asp-route-id="@item.RequestID" class="btn btn-sm btn-success fw-bold px-3 flex-grow-1 flex-sm-grow-0 text-center">
                                    ✓ Approve
                                </a>
                                <a asp-action="Reject" asp-route-id="@item.RequestID" class="btn btn-sm btn-outline-secondary px-3 flex-grow-1 flex-sm-grow-0 text-center">
                                    ✕ Reject
                                </a>
                            }
                            else
                            {
                                <span class="text-muted small fst-italic me-auto">Processed</span>
                            }

                            <a asp-action="Delete" 
                               asp-route-id="@item.RequestID" 
                               class="btn btn-sm btn-outline-danger px-3 flex-grow-1 flex-sm-grow-0 text-center" 
                               onclick="return confirm('Delete this request permanently?')">
                                 Delete
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>