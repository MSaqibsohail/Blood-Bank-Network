@model BloodBankNetwork.Models.BloodRequest

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0">
                <div class="card-header bg-success text-white py-3">
                    <h5 class="mb-0 fw-bold">📋 Create Hospital Blood Request Order</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="HospitalName" class="form-label fw-semibold text-secondary">Requesting Hospital</label>
                            <input asp-for="HospitalName" class="form-control" placeholder="e.g., Aga Khan / Civil Hospital" />
                            <span asp-validation-for="HospitalName" class="text-danger small"></span>
                        </div>

                        <div class="row mb-3">
                            <div class="col-6">
                                <label asp-for="BloodGroup" class="form-label fw-semibold text-secondary">Required Group</label>
                                <select asp-for="BloodGroup" class="form-select">
                                    <option value="">-- Choose Type --</option>
                                    <option value="A+">A+</option>
                                    <option value="A-">A-</option>
                                    <option value="B+">B+</option>
                                    <option value="B-">B-</option>
                                    <option value="O+">O+</option>
                                    <option value="O-">O-</option>
                                    <option value="AB+">AB+</option>
                                    <option value="AB-">AB-</option>
                                </select>
                                <span asp-validation-for="BloodGroup" class="text-danger small"></span>
                            </div>
                            <div class="col-6">
                                <label asp-for="UnitsNeeded" class="form-label fw-semibold text-secondary">Units Requested</label>
                                <input asp-for="UnitsNeeded" type="number" class="form-control" min="1" value="1" />
                                <span asp-validation-for="UnitsNeeded" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-6">
                                <label asp-for="Urgency" class="form-label fw-semibold text-secondary">Urgency Tier Flag</label>
                                <select asp-for="Urgency" class="form-select">
                                    <option value="Normal">Normal Tracking</option>
                                    <option value="High">Emergency Red Alert</option>
                                </select>
                                <span asp-validation-for="Urgency" class="text-danger small"></span>
                            </div>
                            <div class="col-6">
                                <label asp-for="Status" class="form-label fw-semibold text-secondary">Initial Request Status</label>
                                <select asp-for="Status" class="form-select">
                                    <option value="Pending">● Pending Review</option>
                                    <option value="Approved">✓ Pre-Approved</option>
                                    <option value="Rejected">✕ Rejected</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="RequestDate" class="form-label fw-semibold text-secondary">Log Timestamp</label>
                            <input asp-for="RequestDate" type="datetime-local" class="form-control" />
                            <span asp-validation-for="RequestDate" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success w-100 fw-bold">Dispatch Order Request</button>
                            <a asp-action="Index" class="btn btn-outline-secondary w-50">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}