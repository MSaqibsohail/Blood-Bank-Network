@model BloodBankNetwork.Models.Donor

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="mb-0 fw-bold">📋 Register New Blood Donor</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold text-secondary">Full Name</label>
                            <input asp-for="Name" class="form-control" placeholder="e.g., Ali Khan" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="BloodGroup" class="form-label fw-semibold text-secondary">Blood Group</label>
                            <select asp-for="BloodGroup" class="form-select">
                                <option value="">-- Select Blood Type --</option>
                                <option value="A+">A+</option>
                                <option value="A-">A-</option>
                                <option value="B+">B+</option>
                                <option value="B-">B-</option>
                                <option value="O+">O+</option>
                                <option value="O-">O-</option>
                                <option value="AB+">AB+</option>
                                <option value="AB-">AB-</option>
                            </select>
                            <span asp-validation-for="BloodGroup" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Phone" class="form-label fw-semibold text-secondary">Phone Number</label>
                            <input asp-for="Phone" class="form-control" placeholder="e.g., 03001234567" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="City" class="form-label fw-semibold text-secondary">City</label>
                            <input asp-for="City" class="form-control" placeholder="e.g., Karachi" />
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger w-100 fw-bold">Register Donor</button>
                            <a asp-action="Index" class="btn btn-outline-secondary w-50">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}