@model IEnumerable<BloodBankNetwork.Models.User>

<div class="container py-4">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <strong>⚠️ Error:</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <strong>✅ Success:</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
        <h2 class="fw-bold text-dark mb-0">👥 System Workforce Management</h2>
        <a asp-action="Create" class="btn btn-primary fw-semibold shadow-sm">+ Add New Employee</a>
    </div>

    <div class="card shadow border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="p-3">Full Name</th>
                            <th class="p-3">Email Address</th>
                            <th class="p-3">Security Role</th>
                            <th class="p-3 text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="p-3 fw-semibold">@item.FullName</td>
                                <td class="p-3 text-secondary">@item.Email</td>
                                <td class="p-3">
                                    <span class="badge @(item.Role == "Admin" ? "bg-danger" : "bg-secondary") px-3 py-2">
                                        @item.Role
                                    </span>
                                </td>
                                <td class="p-3 text-end">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-action="Edit" asp-route-id="@item.UserID" class="btn btn-warning btn-sm fw-semibold shadow-sm">
                                            Edit
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.UserID" class="btn btn-danger btn-sm fw-semibold shadow-sm" onclick="return confirm('Delete this employee?')">
                                            Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>