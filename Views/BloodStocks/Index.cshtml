@model IEnumerable<BloodBankNetwork.Models.BloodStock>

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <h2 class="fw-bold text-dark mb-0">📦 Blood Stock Inventory</h2>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Create" class="btn btn-success fw-semibold shadow-sm">+ Add Stock</a>
        <form method="get" class="d-flex gap-2">
            <input type="text" 
                   name="search" 
                   class="form-control shadow-sm" 
                   placeholder="Search blood group..." 
                   style="max-width: 300px;" />
            <button type="submit" class="btn btn-primary shadow-sm">Search</button>
            <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">Reset</a>
        </form>
    </div>
</div>

@{
    int rowCount = 1;
}

<div class="card shadow border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="p-3">Sr. No</th>
                        <th class="p-3">Blood Bank</th>
                        <th class="p-3 text-center">Blood Group</th>
                        <th class="p-3 text-center">Available Units (Bags)</th>
                        <th class="p-3">Last Updated</th>
                        <th class="p-3 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach(var item in Model)
                {
                    <tr>
                        <td class="p-3 fw-semibold text-dark">@(rowCount++)</td>
                        <td class="p-3 fw-semibold">@(item.BloodBank?.BankName ?? "Unknown Center")</td>
                        <td class="p-3 text-center"><span class="badge bg-danger px-2.5 py-1.5">@item.BloodGroup</span></td>
                        <td class="p-3 text-center fw-bold text-dark">@item.Units</td>
                        <td class="p-3 text-muted">@item.LastUpdated.ToString("MM/dd/yyyy hh:mm tt")</td>
                        <td class="p-3 text-end">
                            <div class="d-inline-flex gap-2">
                                <a asp-action="Edit"
                                   asp-route-id="@item.StockID"
                                   class="btn btn-warning btn-sm fw-semibold shadow-sm">
                                     Edit
                                </a>
                                <a asp-action="Delete"
                                   asp-route-id="@item.StockID"
                                   class="btn btn-danger btn-sm fw-semibold shadow-sm"
                                   onclick="return confirm('Delete this stock record?')">
                                     Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>