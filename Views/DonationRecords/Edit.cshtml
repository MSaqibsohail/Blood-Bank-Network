@model BloodBankNetwork.Models.DonationRecord

<a asp-action="Index"
   class="btn btn-outline-secondary mb-3">
    ← Back to List
</a>

<h2>Edit Donation</h2>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="DonationID" />

    <div class="mb-3">
        <label>Donor</label>
        <select asp-for="DonorID"
                asp-items="ViewBag.Donors"
                class="form-control select2-donor">
        </select>
    </div>

    <div class="mb-3">
        <label>Blood Bank</label>
        <select asp-for="BankID"
                asp-items="ViewBag.Banks"
                class="form-control select2-bank">
        </select>
    </div>

   <input type="hidden" asp-for="BloodGroup" />

<div class="mb-3">
    <label class="form-label fw-bold text-muted">Donor Blood Group (Immutable)</label>
    <input class="form-control bg-light" value="@Model.BloodGroup" readonly disabled />
</div>

    <div class="mb-3">
        <label>Units Donated</label>

        <input asp-for="UnitsDonated"
               class="form-control" />
    </div>

    <button class="btn btn-primary">
        Update
    </button>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <!-- Select2 CSS & Theme -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />

    <!-- Select2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).ready(function () {
            $('.select2-donor').select2({
                theme: 'bootstrap-5',
                placeholder: '-- Choose Registered Donor --',
                allowClear: true
            });
            $('.select2-bank').select2({
                theme: 'bootstrap-5',
                placeholder: '-- Select Receiving Center --',
                allowClear: true
            });
        });
    </script>
}