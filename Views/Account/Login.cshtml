@model BloodBankNetwork.Models.User
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Blood Bank Network</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        body {
            background: linear-gradient(135deg, #120000 0%, #3a0000 50%, #080000 100%);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .login-card {
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 16px;
        }
        .form-control {
            background-color: rgba(0, 0, 0, 0.3) !important;
            border: 1px solid rgba(255, 255, 255, 0.15) !important;
            color: #ffffff !important;
            transition: all 0.3s ease;
        }
        .form-control::placeholder {
            color: rgba(255, 255, 255, 0.4) !important;
        }
        .form-control:focus {
            background-color: rgba(0, 0, 0, 0.5) !important;
            border-color: #ff3344 !important;
            box-shadow: 0 0 10px rgba(255, 51, 68, 0.35) !important;
            color: #ffffff !important;
        }
        .btn-danger {
            background-color: #dc3545;
            border: none;
            transition: all 0.3s ease;
        }
        .btn-danger:hover {
            background-color: #ff3344;
            box-shadow: 0 0 15px rgba(255, 51, 68, 0.6) !important;
            transform: translateY(-1px);
        }
        .input-group-text-btn {
            background-color: rgba(0, 0, 0, 0.3) !important;
            border: 1px solid rgba(255, 255, 255, 0.15) !important;
            border-left: none !important;
            color: rgba(255, 255, 255, 0.7) !important;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        .input-group-text-btn:hover {
            color: #ffffff !important;
            background-color: rgba(255, 255, 255, 0.1) !important;
        }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center" style="height: 100vh;">
    <div class="card shadow-lg login-card" style="width: 420px;">
        <div class="card-header bg-transparent text-center py-4 border-0">
            <h2 class="mb-0 fw-bold text-white">🩸 BloodBank<span class="text-danger">Network</span></h2>
            <div class="text-white opacity-75 mt-1 small">Workforce Authenticator Terminal</div>
        </div>
        <div class="card-body p-4 pt-0">
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger small py-2 bg-danger border-0 text-white shadow-sm">
                    <strong>⚠️ Error:</strong> @ViewBag.Error
                </div>
            }
            <form asp-action="Login" method="post">
                <div class="mb-3">
                    <label class="form-label text-light opacity-90 fw-semibold">Email Address</label>
                    <input type="email" name="email" class="form-control px-3 py-2" placeholder="name@bloodbank.com" required />
                </div>
                <div class="mb-4">
                    <label class="form-label text-light opacity-90 fw-semibold">Secure Password</label>
                    <div class="input-group">
                        <input type="password" name="password" id="password" class="form-control px-3 py-2" placeholder="••••••••" style="border-right: none !important;" required />
                        <button class="btn input-group-text-btn" type="button" id="togglePassword">
                            <span id="eyeIcon"></span>
                        </button>
                    </div>
                </div>
                <button type="submit" class="btn btn-danger w-100 fw-bold py-2.5">Sign In</button>
            </form>
        </div>
    </div>

    <script>
        document.getElementById('togglePassword').addEventListener('click', function () {
            const passwordInput = document.getElementById('password');
            const eyeIcon = document.getElementById('eyeIcon');
            
            const eyeSvg = `
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                  <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/>
                  <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/>
                </svg>
            `;
            const eyeSlashSvg = `
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                  <path d="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a8.8 8.8 0 0 0-2.79.444l.74 1.157C6.56 4.048 7.26 4 8 4c4.686 0 8.22 4.025 8.22 4s-.815 1.705-2.414 3.018l.82 1.28c.34-.336.65-.694.93-1.077zm-1.88 1.153a8 8 0 0 1-1.96 1.057L9.067 12.2a4.5 4.5 0 0 0-1.468.082L5.835 14.7a10 10 0 0 1-2.264-1.57l.826-1.29A8 8 0 0 1 2.24 9.176L.622 11.53c-.324-.316-.62-.654-.888-1.011zm-4.32-2.316a3 3 0 0 0 2.22 2.22l-.76 1.19a4.5 4.5 0 0 1-3.34-3.34z"/>
                  <path d="M12.44 14l-1.328-2.075a3.5 3.5 0 0 0-4.95-4.95L4.835 4.897a5.5 5.5 0 0 1 7.605 7.605L13.73 14h-.79zm-4.44-8.8a1 1 0 0 1 1 1c0 .064-.006.126-.017.186L7.18 4.22c.06-.01.122-.017.186-.017zm-4.22 6.82l-1.28 2a11 11 0 0 1-2.484-3.18 10 10 0 0 1-.017-1.61L2.24 9.186c.06-.01.12-.017.186-.017a1 1 0 0 1 1 1c0 .064-.006.126-.017.186z"/>
                </svg>
            `;

            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                eyeIcon.innerHTML = eyeSlashSvg;
            } else {
                passwordInput.type = 'password';
                eyeIcon.innerHTML = eyeSvg;
            }
        });

        // Initialize default icon
        document.getElementById('eyeIcon').innerHTML = `
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
              <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/>
              <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/>
            </svg>
        `;
    </script>
</body>
</html>